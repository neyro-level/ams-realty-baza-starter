{
	"schemaVersion": 1,
	"allowedRouteFiles": [
		"src/app/api/internal/revalidate/route.ts",
		"src/app/(payload)/api/[[...slug]]/route.ts",
		"src/app/(payload)/api/graphql/route.ts",
		"src/app/(payload)/api/graphql-playground/route.ts"
	],
	"anonymousDenyCollections": [
		"pages",
		"properties",
		"feed-sources",
		"import-runs",
		"import-issues",
		"leads",
		"lead-deliveries",
		"media",
		"redirects"
	],
	"anonymousAuthAllowPaths": [
		"/api/users/login",
		"/api/users/logout",
		"/api/users/refresh-token",
		"/api/users/forgot-password",
		"/api/users/reset-password",
		"/api/users/verify"
	],
	"note": "Every app API route must be explicitly approved here. Raw anonymous business REST remains denied by default."
}
